# Copy these into Render → Environment
MONGODB_URL=your_mongodb_atlas_connection_string
JWT_SECRET=your_jwt_secret
PORT=3004
# Frontend origin(s), comma-separated. No trailing slash.
# Use https://*-your-team.vercel.app to allow all Vercel preview deploys.
CLIENT_URL=http://localhost:5173,https://your-app.vercel.app,https://*-your-team.vercel.app
